# Loaded by `npm run dev:emulator` (vite --mode emulator). Overrides .env so the app
# talks only to the local Auth + Firestore emulators — nothing reaches setu-india.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-setu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-setu
VITE_FIREBASE_APP_ID=demo-app
