rules_version = '2';

// SETU — Firestore security rules.
//
// Enforces SETU-SPEC.md Part 7 (visibility, routing, privacy).
// Roles live in users/{uid}.role. Custom claims would need a server, and SETU runs
// on the Spark plan with no Cloud Functions, so every check reads the users record.
//
// Beneficiary privacy is enforced with a lock: accepting a call sets
// beneficiaries/{id}.activeHandler to the official, in the same batch that claims the
// call. Identity is readable only while that lock is held, editable only while the call
// is 'active', and hidden again when the report is sent and the lock released.
//
// Call lifecycle (calls/{id}.status): waiting → active → report-review → completed.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Identity ─────────

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function staffPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // An active official with a valid role. Every rule below builds on this.
    function isStaff() {
      return signedIn()
        && exists(staffPath())
        && get(staffPath()).data.get('isActive', false) == true
        && get(staffPath()).data.get('role', '') in ['executive', 'resourcePerson', 'admin'];
    }

    function hasRole(role) {
      return isStaff() && get(staffPath()).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isExecutive() {
      return hasRole('executive');
    }

    function isResourcePerson() {
      return hasRole('resourcePerson');
    }

    // The write touches only these top-level fields.
    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function callPath(callId) {
      return /databases/$(database)/documents/calls/$(callId);
    }

    // ───────── users ─────────

    match /users/{userId} {
      // Anyone signed in may read their own record (so the app can explain a missing or
      // deactivated account). Active staff may read the staff directory.
      allow read: if signedIn() && (me() == userId || isStaff());

      // Only admins create accounts or change roles. Deactivate rather than delete.
      allow create, update: if isAdmin()
        && request.resource.data.role in ['executive', 'resourcePerson', 'admin']
        && request.resource.data.isActive is bool;
      allow delete: if false;
    }

    // ───────── beneficiaries ─────────

    match /beneficiaries/{beneficiaryId} {

      function heldByMe(data) {
        return data.get('activeHandler', null) == me();
      }

      function isMyTrainee(data) {
        return isResourcePerson() && data.get('assignedResourcePerson', null) == me();
      }

      // Accepting a call: take the lock in the same batch that claims the call.
      function takesLock() {
        let call = getAfter(callPath(request.resource.data.activeCallId)).data;
        return resource.data.get('activeHandler', null) == null
          && request.resource.data.activeHandler == me()
          && changesOnly(['activeHandler', 'activeCallId'])
          && call.handledBy == me()
          && call.status == 'active'
          && call.beneficiaryId == beneficiaryId;
      }

      /**
       * Spec 4.1 Stage 2: correct what the AI captured, only while the call is active.
       *
       * The list is the identity and circumstances the caller gave over the phone — the
       * things an official on the line is in a position to correct. It deliberately stops
       * short of trainingStatus, employmentStatus and the attendance record: those are the
       * trainer's to set from what actually happened at the centre, not something to be
       * changed on a caller's say-so.
       */
      function editsDuringCall() {
        return heldByMe(resource.data)
          && getAfter(callPath(resource.data.activeCallId)).data.status == 'active'
          && changesOnly([
            'name', 'age', 'gender', 'primaryNumber', 'secondaryNumber',
            'hasWhatsAppPrimary', 'hasWhatsAppSecondary', 'isBasicPhoneOnly',
            'preferredLanguage', 'district', 'block', 'village',
            'educationLevel', 'currentWork', 'interests', 'constraints',
            'consentGiven', 'recommendation', 'rejectedCourses', 'updatedAt'
          ]);
      }

      // Sending the report releases the lock; identity is hidden again.
      function releasesLock() {
        return heldByMe(resource.data)
          && request.resource.data.get('activeHandler', null) == null
          && request.resource.data.get('activeCallId', null) == null
          && changesOnly(['activeHandler', 'activeCallId'])
          && getAfter(callPath(resource.data.activeCallId)).data.status == 'completed';
      }

      // Spec 5.1: a trainer maintains status and recommendations for their own trainees.
      // Training and employment are separate fields: certified and unplaced co-exist.
      function trainerUpdate() {
        return isMyTrainee(resource.data)
          && changesOnly([
            'trainingStatus', 'employmentStatus', 'statusHistory',
            'completionRecommendation', 'certificateId', 'certificateIssuedAt',
            'flags', 'updatedAt'
          ])
          // A certificate is only ever issued against a certified record. Certifying and
          // issuing are one act in the console; this is what stops them coming apart.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['certificateId'])
              || request.resource.data.trainingStatus == 'certified');
      }

      allow read: if isAdmin()
        || (isStaff() && heldByMe(resource.data))
        || isMyTrainee(resource.data);

      /**
       * A caller the AI line has just spoken to for the first time. Same reasoning as the
       * gapData counter: in production the AI writes this server-side, and on Spark the
       * call runs in the browser. The record is created cold — no handler holds it, so it
       * is immediately subject to the same privacy lock as every other beneficiary — and
       * it must say the AI line produced it.
       */
      function createsFromAiCall() {
        return isStaff()
          && request.resource.data.createdBy == 'ai-call'
          && request.resource.data.get('activeHandler', null) == null
          && request.resource.data.get('activeCallId', null) == null;
      }

      allow create: if isAdmin() || createsFromAiCall();
      allow update: if isAdmin()
        || (isStaff() && (takesLock() || editsDuringCall() || releasesLock() || trainerUpdate()));
      allow delete: if false;
    }

    // ───────── calls ─────────

    match /calls/{callId} {

      function mayHandle(data) {
        return (isExecutive() && data.callType == 'executive')
          || (isResourcePerson() && data.callType == 'resourcePerson' && data.get('assignedTo', null) == me());
      }

      // Accept is the only queue action; the first official to accept wins.
      function accepts() {
        return mayHandle(resource.data)
          && resource.data.status == 'waiting'
          && resource.data.get('handledBy', null) == null
          && request.resource.data.status == 'active'
          && request.resource.data.handledBy == me()
          && changesOnly(['status', 'handledBy', 'startedAt', 'updatedAt']);
      }

      // During the call: record a transfer; ending it moves to mandatory report review.
      function updatesActiveCall() {
        return resource.data.get('handledBy', null) == me()
          && resource.data.status == 'active'
          && request.resource.data.status in ['active', 'report-review']
          && changesOnly(['status', 'endedAt', 'duration', 'transferredTo', 'transferReason', 'outcome', 'updatedAt']);
      }

      // Report review: edit and send. Once 'completed' the call is locked.
      function reviewsReport() {
        return resource.data.get('handledBy', null) == me()
          && resource.data.status == 'report-review'
          && request.resource.data.status in ['report-review', 'completed']
          && changesOnly(['status', 'editedReport', 'reportSentAt', 'reportChannels', 'outcome', 'updatedAt']);
      }

      // Spec 7.2: a resource person receives cases only as callbacks from an executive's active call.
      function createsTransfer() {
        let source = get(callPath(request.resource.data.transferredFromCallId)).data;
        let target = get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data;
        return isExecutive()
          && request.resource.data.callType == 'resourcePerson'
          && request.resource.data.subType in ['course-related', 'common-related']
          && request.resource.data.status == 'waiting'
          && request.resource.data.get('handledBy', null) == null
          && source.handledBy == me()
          && source.status == 'active'
          && source.beneficiaryId == request.resource.data.beneficiaryId
          && target.role == 'resourcePerson'
          && target.isActive == true;
      }

      /**
       * The report an official files at the end of their own call.
       *
       * It is a separate document because it is what the Completed Calls list reads, and
       * that list carries no identity — so the report cannot simply be fields added to
       * the call. An official may file one only against a call they handled, and only
       * once it has reached report review: the review is mandatory, and a report that
       * could be created straight from an active call would make it optional.
       */
      function filesOwnReport() {
        let source = get(callPath(request.resource.data.sourceCallId)).data;
        return isStaff()
          && request.resource.data.recordType == 'completed'
          && request.resource.data.status == 'completed'
          && request.resource.data.handledBy == me()
          && source.get('handledBy', null) == me()
          && source.status in ['report-review', 'completed'];
      }

      // Call documents carry no beneficiary identity (that lives in /private), so the
      // queue is visible to every executive. AI calls are admin-only.
      allow read: if isAdmin()
        || (isExecutive() && resource.data.callType == 'executive'
            && (resource.data.status == 'waiting' || resource.data.get('handledBy', null) == me()))
        || (isResourcePerson() && resource.data.callType == 'resourcePerson'
            && resource.data.get('assignedTo', null) == me());

      allow create: if isAdmin() || createsTransfer() || filesOwnReport();
      allow update: if isAdmin()
        || (isStaff() && (accepts() || updatesActiveCall() || reviewsReport()));
      allow delete: if false;

      // Transcript, AI context and call notes can identify the beneficiary, so they follow
      // the same rule as the beneficiary record: visible to the handler only during the
      // call and report review.
      match /private/{docId} {
        function parentCall() {
          return get(callPath(callId)).data;
        }

        allow read: if isAdmin()
          || (isStaff() && parentCall().get('handledBy', null) == me()
              && parentCall().status in ['active', 'report-review']);

        // Admin (AI escalation) writes context; an executive may attach context to their own transfer.
        allow create: if isAdmin()
          || (isExecutive()
              && getAfter(callPath(callId)).data.callType == 'resourcePerson'
              && get(callPath(getAfter(callPath(callId)).data.transferredFromCallId)).data.handledBy == me());

        allow update: if isAdmin()
          || (isStaff() && parentCall().get('handledBy', null) == me()
              && parentCall().status == 'active'
              && changesOnly(['notes']));
        allow delete: if false;
      }
    }

    // ───────── staff ─────────

    // The Admin console's staff directory: postings, assigned courses, activity.
    // Separate from /users, which holds the sign-in accounts — creating an auth account
    // for somebody else needs a server, and this project runs on Spark. So an admin
    // files the directory record here and the account is issued separately.
    match /staff/{staffId} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['executive', 'resourcePerson']
        && request.resource.data.active is bool;
      // Deactivate rather than delete, so the history survives (spec 6.2).
      allow delete: if false;
    }

    // ───────── batches ─────────

    // A batch carries the schedule that decides when an attendance sheet opens, and the
    // course materials. Spec 5.2: the trainer running the batch maintains both.
    match /batches/{batchId} {
      function isMyBatch() {
        return isResourcePerson() && resource.data.get('assignedResourcePerson', null) == me();
      }

      allow read: if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isMyBatch() && changesOnly(['schedule', 'materials', 'updatedAt']));
      allow delete: if false;
    }

    // ───────── followUps ─────────

    // Automated AI follow-up records — admin only (spec 7.1).
    match /followUps/{followUpId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // ───────── courses & centres ─────────

    match /courses/{courseId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /centres/{centreId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      // Spec 5.2: the trainer sets their own centre's schedule and online link.
      allow update: if isAdmin()
        || (isResourcePerson()
            && resource.data.get('assignedResourcePerson', null) == me()
            && changesOnly(['schedule', 'onlineLink', 'updatedAt']));
      allow delete: if false;
    }

    // ───────── attendance ─────────

    match /attendance/{attendanceId} {
      function trainsAt(centreId) {
        return get(/databases/$(database)/documents/centres/$(centreId)).data
          .get('assignedResourcePerson', null) == me();
      }

      allow read: if isAdmin() || (isResourcePerson() && resource.data.markedBy == me());
      allow create: if isAdmin()
        || (isResourcePerson()
            && request.resource.data.markedBy == me()
            && trainsAt(request.resource.data.centreId));
      allow update: if isAdmin()
        || (isResourcePerson()
            && resource.data.markedBy == me()
            && request.resource.data.markedBy == me()
            && request.resource.data.centreId == resource.data.centreId
            && trainsAt(resource.data.centreId));
      allow delete: if false;
    }

    // ───────── adminFlags ─────────

    match /adminFlags/{flagId} {
      allow read: if isAdmin() || (isResourcePerson() && resource.data.raisedBy == me());
      // Spec 5.1: Flag to Admin, for the trainer's own trainees.
      allow create: if isAdmin()
        || (isResourcePerson()
            && request.resource.data.raisedBy == me()
            && request.resource.data.status == 'open'
            && get(/databases/$(database)/documents/beneficiaries/$(request.resource.data.beneficiaryId)).data
                 .get('assignedResourcePerson', null) == me());
      // Spec 6.7: the admin acts on a flag — assigns an officer, or closes it.
      //
      // Stated as what must not change rather than what may: the reason, the note and the
      // name on it are the trainer's account of what happened, and an admin closing a case
      // must not be able to edit the report that raised it. Anything else about the flag
      // is the admin's to set, which is also what lets the seeder rewrite it wholesale.
      allow update: if isAdmin()
        && request.resource.data.status in ['open', 'assigned', 'resolved']
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.note == resource.data.get('note', '')
        && request.resource.data.raisedBy == resource.data.raisedBy;
      allow delete: if false;
    }

    // ───────── gapData ─────────

    match /gapData/{gapId} {
      /**
       * The one place these rules go beyond Part 7, and deliberately.
       *
       * Part 7 makes gap analytics admin-only, and reads stay that way. But the dialect
       * gap is discovered by the AI line, not by an official: when the two detection
       * models disagree about a caller, that block has a language SETU cannot serve, and
       * the map has to learn it. In production the AI answers the phone on a server with
       * its own credentials. On Spark there is no server — the call runs in the browser
       * under whichever official is signed in — so the increment has to be allowed from
       * a staff session.
       *
       * It is kept as narrow as the rules language allows: one named counter, one step at
       * a time, nothing else on the document touched. A staff member can record that a
       * dialect gap happened. They cannot read the analytics, invent a block, or move any
       * other number on it.
       */
      function recordsContestedDetection() {
        return isStaff()
          && changesOnly(['contestedDetections', 'updatedAt'])
          && request.resource.data.contestedDetections == resource.data.get('contestedDetections', 0) + 1;
      }

      allow read, create: if isAdmin();
      allow update: if isAdmin() || recordsContestedDetection();
      allow delete: if false;
    }

    // Anything not matched above is denied.
  }
}
