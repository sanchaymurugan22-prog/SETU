{
  "name": "setu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "firebase emulators:exec --project demo-setu --only auth,firestore \"node scripts/seed-emulator.mjs && vite --mode emulator\"",
    "build": "npm run i18n:check && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --project demo-setu --only firestore \"vitest run tests/firestore.rules.test.ts --testTimeout=20000\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:bhashini": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/bhashini.live.test.ts",
    "voice:build": "node --env-file=.env scripts/pregenerate-voice.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.14",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
