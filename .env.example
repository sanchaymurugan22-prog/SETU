# Copy to .env and fill in. .env is git-ignored.

# Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Bhashini (ULCA) credentials for the voice layer — from the Bhashini dashboard
VITE_BHASHINI_APP_ID=
VITE_BHASHINI_UDYAT_KEY=
VITE_BHASHINI_INFERENCE_KEY=

# The admin account used by `npm run seed:firestore` to write the sample into Firestore.
# The security rules only let an admin write gapData and beneficiaries, so this must be
# an account whose users/{uid}.role is "admin".
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
